rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(userId) {
      return isGoogleUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.email == 'jonaseocara727@gmail.com'
          || request.auth.token.email == 'bitdoglab@gmail.com'
        );
    }

    function validListQuery(maxLimit) {
      return request.query.limit != null && request.query.limit <= maxLimit;
    }

    function validNewProjectId(projectId, userId) {
      return projectId == userId + '_0'
        || projectId == userId + '_1'
        || projectId == userId + '_2'
        || projectId == userId + '_3'
        || projectId == userId + '_4'
        || projectId == userId + '_5'
        || projectId == userId + '_6'
        || projectId == userId + '_7'
        || projectId == userId + '_8'
        || projectId == userId + '_9'
        || projectId == userId + '_10'
        || projectId == userId + '_11'
        || projectId == userId + '_12'
        || projectId == userId + '_13'
        || projectId == userId + '_14'
        || projectId == userId + '_15'
        || projectId == userId + '_16'
        || projectId == userId + '_17'
        || projectId == userId + '_18'
        || projectId == userId + '_19';
    }

    function validUserPublicData(data) {
      return data.keys().hasOnly([
          'name', 'bio', 'photoURL', 'projectCount', 'commentCount',
          'createdAt', 'updatedAt', 'linkedin', 'github', 'projectMutationId'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.bio is string
        && data.bio.size() <= 200
        && data.projectCount is int
        && data.projectCount >= 0
        && data.projectCount <= 20
        && data.commentCount is int
        && data.commentCount >= 0
        && data.commentCount <= 500
        && (!('projectMutationId' in data) || (
          data.projectMutationId is string
          && data.projectMutationId.size() <= 160
        ))
        && (!('photoURL' in data) || data.photoURL is string && data.photoURL.size() <= 1000)
        && (!('linkedin' in data) || (
          data.linkedin is string
          && data.linkedin.size() <= 200
          && (data.linkedin.size() == 0 || data.linkedin.matches('https://(www\\.)?linkedin\\.com/in/[^/ ]+/?'))
        ))
        && (!('github' in data) || (
          data.github is string
          && data.github.size() <= 200
          && (data.github.size() == 0 || data.github.matches('https://(www\\.)?github\\.com/[^/ ]+/?'))
        ));
    }

    function validNewUserData(data) {
      return validUserPublicData(data)
        && data.projectCount == 0
        && data.commentCount == 0
        && (!('projectMutationId' in data) || data.projectMutationId == '');
    }

    function validOwnerProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return validUserPublicData(request.resource.data)
        && changed.hasOnly([
          'name', 'bio', 'linkedin', 'github', 'updatedAt', 'email'
        ])
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.projectCount == resource.data.projectCount
        && request.resource.data.get('projectMutationId', '') == resource.data.get('projectMutationId', '')
        && request.resource.data.updatedAt == request.time;
    }

    function validOwnerProjectCounterUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let projectId = request.resource.data.projectMutationId;
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      let incrementing = request.resource.data.projectCount == resource.data.projectCount + 1
        && resource.data.projectCount < 20
        && !exists(projectPath)
        && existsAfter(projectPath)
        && getAfter(projectPath).data.authorId == userId;
      let decrementing = request.resource.data.projectCount == resource.data.projectCount - 1
        && resource.data.projectCount > 0
        && exists(projectPath)
        && get(projectPath).data.authorId == userId
        && !existsAfter(projectPath);
      return validUserPublicData(request.resource.data)
        && changed.hasOnly(['projectCount', 'projectMutationId', 'updatedAt', 'email'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.bio == resource.data.bio
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.get('linkedin', '') == resource.data.get('linkedin', '')
        && request.resource.data.get('github', '') == resource.data.get('github', '')
        && request.resource.data.updatedAt == request.time
        && (incrementing || decrementing);
    }

    function validImageMeta(meta) {
      return meta is map
        && meta.keys().hasOnly(['name', 'size', 'type'])
        && meta.name is string
        && meta.name.size() <= 120
        && meta.size is int
        && meta.size >= 0
        && meta.size <= 2 * 1024 * 1024
        && meta.type is string
        && meta.type.matches('image/(jpeg|png|webp|gif)');
    }

    function validLessonPdfMeta(meta) {
      return meta is map
        && meta.keys().hasOnly(['name', 'size', 'type'])
        && meta.name is string
        && meta.name.size() <= 120
        && meta.size is int
        && meta.size >= 0
        && meta.size <= 10 * 1024 * 1024
        && meta.type == 'application/pdf';
    }

    function validPythonFilename(name) {
      return name is string
        && name.size() > 3
        && name.size() <= 120
        && name.matches('[A-Za-z0-9][A-Za-z0-9_-]*\\.py');
    }

    function validLibrary(lib) {
      return lib is map
        && lib.keys().hasOnly(['name', 'content'])
        && validPythonFilename(lib.name)
        && lib.content is string
        && lib.content.size() <= 102400;
    }

    function validLibraryItem(libraries, index) {
      return libraries.size() <= index || validLibrary(libraries[index]);
    }

    function validLibraries(libraries) {
      return libraries is list
        && libraries.size() <= 10
        && validLibraryItem(libraries, 0)
        && validLibraryItem(libraries, 1)
        && validLibraryItem(libraries, 2)
        && validLibraryItem(libraries, 3)
        && validLibraryItem(libraries, 4)
        && validLibraryItem(libraries, 5)
        && validLibraryItem(libraries, 6)
        && validLibraryItem(libraries, 7)
        && validLibraryItem(libraries, 8)
        && validLibraryItem(libraries, 9);
    }

    function validStringItem(items, index, maxSize) {
      return items.size() <= index || (items[index] is string && items[index].size() <= maxSize);
    }

    function validProjectStringList(items, maxItems, minItems, maxSize) {
      return items is list
        && items.size() >= minItems
        && items.size() <= maxItems
        && validStringItem(items, 0, maxSize)
        && validStringItem(items, 1, maxSize)
        && validStringItem(items, 2, maxSize)
        && validStringItem(items, 3, maxSize)
        && validStringItem(items, 4, maxSize)
        && validStringItem(items, 5, maxSize)
        && validStringItem(items, 6, maxSize)
        && validStringItem(items, 7, maxSize)
        && validStringItem(items, 8, maxSize)
        && validStringItem(items, 9, maxSize);
    }

    function validOptionalVideoUrl(url) {
      return url is string
        && url.size() <= 1000
        && (
          url.size() == 0
          || url.matches('https://(www\\.)?youtube\\.com/.*')
          || url.matches('https://youtu\\.be/.*')
          || url.matches('https://drive\\.google\\.com/.*')
        );
    }

    function validOptionalGithubUrl(url) {
      return url is string
        && url.size() <= 1000
        && (
          url.size() == 0
          || url.matches('https://(www\\.)?github\\.com/[^/]+/[^/]+.*')
        );
    }

    function validProjectData(data, projectId) {
      return data.keys().hasOnly([
          'title', 'description', 'materials', 'videoURL', 'githubURL', 'imageURL', 'imagePath', 'imageMeta',
          'lessonPdfURL', 'lessonPdfPath', 'lessonPdfMeta',
          'authorId', 'authorName', 'authorPhoto', 'mainFile', 'libraries',
          'pdfLinks', 'extraLinks', 'bnccCodes', 'commentCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'title', 'description', 'materials', 'videoURL', 'githubURL', 'authorId', 'authorName',
          'mainFile', 'libraries', 'pdfLinks', 'extraLinks', 'bnccCodes', 'commentCount'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.materials is string
        && data.materials.size() > 0
        && data.materials.size() <= 2000
        && data.authorId is string
        && data.authorId.size() > 0
        && data.authorId.size() <= 128
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 200
        && validOptionalVideoUrl(data.videoURL)
        && validOptionalGithubUrl(data.githubURL)
        && (!('authorPhoto' in data) || data.authorPhoto is string && data.authorPhoto.size() <= 1000)
        && (!('imageURL' in data) || data.imageURL is string && data.imageURL.size() <= 2000)
        && (!('imagePath' in data) || (
          data.imagePath is string
          && (data.imagePath.size() == 0 || data.imagePath == 'project-covers/' + data.authorId + '/' + projectId + '/cover')
        ))
        && (!('imageMeta' in data) || data.imageMeta == null || validImageMeta(data.imageMeta))
        && (!('lessonPdfURL' in data) || data.lessonPdfURL is string && data.lessonPdfURL.size() <= 2000)
        && (!('lessonPdfPath' in data) || (
          data.lessonPdfPath is string
          && (data.lessonPdfPath.size() == 0 || data.lessonPdfPath == 'project-guides/' + data.authorId + '/' + projectId + '/lesson-plan')
        ))
        && (!('lessonPdfMeta' in data) || data.lessonPdfMeta == null || validLessonPdfMeta(data.lessonPdfMeta))
        && data.mainFile is map
        && data.mainFile.keys().hasOnly(['name', 'content'])
        && validPythonFilename(data.mainFile.name)
        && data.mainFile.content is string
        && data.mainFile.content.size() <= 102400
        && validLibraries(data.libraries)
        && validProjectStringList(data.pdfLinks, 5, 0, 1000)
        && validProjectStringList(data.extraLinks, 5, 0, 1000)
        && validProjectStringList(data.bnccCodes, 10, 1, 20)
        && data.commentCount is int
        && data.commentCount >= 0
        && data.commentCount <= 500;
    }

    function validProjectUpdateData(projectId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return validProjectData(request.resource.data, projectId)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorPhoto == resource.data.authorPhoto
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.commentCount == resource.data.commentCount
        && changed.hasOnly([
          'title', 'description', 'materials', 'videoURL', 'githubURL',
          'imageURL', 'imagePath', 'imageMeta',
          'lessonPdfURL', 'lessonPdfPath', 'lessonPdfMeta',
          'mainFile', 'libraries', 'pdfLinks', 'extraLinks', 'bnccCodes', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function validProjectCounterCreate(projectId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath)
        && get(userPath).data.projectCount < 20
        && getAfter(userPath).data.projectCount == get(userPath).data.projectCount + 1
        && getAfter(userPath).data.projectMutationId == projectId;
    }

    function validProjectCounterDelete(projectId) {
      let userPath = /databases/$(database)/documents/users/$(resource.data.authorId);
      return exists(userPath)
        && get(userPath).data.projectCount > 0
        && getAfter(userPath).data.projectCount == get(userPath).data.projectCount - 1
        && getAfter(userPath).data.projectMutationId == projectId;
    }

    // Usuarios: leitura publica limitada; o proprio edita dados publicos; admin pode ajustar.
    match /users/{userId} {
      allow get: if true;
      allow list: if validListQuery(50);
      allow create: if isOwner(userId) && validNewUserData(request.resource.data);
      allow update: if (isOwner(userId) && (
                        validOwnerProfileUpdate()
                        || validOwnerProjectCounterUpdate(userId)
                      ))
                    || (isAdmin() && validUserPublicData(request.resource.data));
      allow delete: if false;
    }

    // Projetos: leitura publica limitada; autor gerencia o proprio; admin gerencia qualquer projeto.
    match /projects/{projectId} {
      allow get: if true;
      allow list: if validListQuery(50);
      allow create: if isGoogleUser()
                    && validNewProjectId(projectId, request.auth.uid)
                    && request.resource.data.authorId == request.auth.uid
                    && validProjectData(request.resource.data, projectId)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && validProjectCounterCreate(projectId);
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isAdmin())
                    && validProjectUpdateData(projectId);
      allow delete: if isAdmin()
                    || (isGoogleUser()
                      && resource.data.authorId == request.auth.uid
                      && validProjectCounterDelete(projectId));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
